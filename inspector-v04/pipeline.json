          "path": "output/{replay}/runtime_ground_soul_lifecycle_production_v01.json",
          "minBytes": 2
        },
        {
          "path": "output/{replay}/runtime_ground_soul_lifecycle_events_v01.jsonl",
          "minBytes": 0
        }
      ]
