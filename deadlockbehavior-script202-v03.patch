+        {
+          recordKey:
+            'upgrade_plain',
+
+          directProvidedStats: [],
+
+          meaningfulDirectProvidedStats: [],
+
+          weaponStateRelevant: {},
+        },
+      ],
+    });
+
+  assert.equal(
+    result.universe.itemCount,
+    2,
+  );
+
+  assert.equal(
+    result.currentAmmoCandidateCount,
+    1,
+  );
+
+  assert.equal(
+    result.noAmmoEvidenceCount,
+    1,
+  );
