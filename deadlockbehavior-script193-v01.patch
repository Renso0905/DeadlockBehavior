+test('combined logical ammo uses main plus bonus ZigZag counters', () => {
+  assert.equal(
+    combinedLogicalAmmo({
+      rawClip: -5,
+      bonusClip: 4,
+    }),
+    17,
+  );
+});
+
+test('strict zero attack can settle one tick later without a new shot', () => {
+  const settled = [
+    {
+      tick: 1,
+      sourceIndex: 0,
+      heroId: 1,
+      playerKey: 'p',
+      weaponEntityIndex: 1,
+      effectContextId: 'ctx',
+      activeFireMode: 1,
+      inReload: false,
+      shotNumber: 1,
+      rawClip: -5,
+      bonusClip: 0,
+      ammoFraction: 0,
+    },
+    {
+      tick: 2,
+      sourceIndex: 1,
+      heroId: 1,
+      playerKey: 'p',
+      weaponEntityIndex: 1,
+      effectContextId: 'ctx',
+      activeFireMode: 1,
+      inReload: false,
+      shotNumber: 2,
+      rawClip: -5,
+      bonusClip: 0,
+      ammoFraction: 0,
+    },
+    {
+      tick: 3,
+      sourceIndex: 2,
+      heroId: 1,
+      playerKey: 'p',
+      weaponEntityIndex: 1,
+      effectContextId: 'ctx',
+      activeFireMode: 1,
+      inReload: false,
+      shotNumber: 2,
+      rawClip: 4,
+      bonusClip: 0,
+      ammoFraction: 0,
+    },
+  ];
+
+  const groups = new Map([
+    ['p|1', settled],
+  ]);
+
+  const rows =
+    deriveStrictAttackTransitionsWithIndex(
+      groups,
