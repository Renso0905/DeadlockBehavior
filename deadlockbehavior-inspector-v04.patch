+function permanentAt(p,t){let s={};for(const e of p.permanentBuffs?.events??[]){if(e.time<=t)s=e.state;else break;}return Object.fromEntries(Object.entries(s??{}).map(([k,v])=>[k,{inferredUnits:v?.inferredUnits??0,totalValue:v?.totalValue??0}]));}
+function bridgesAt(p,t){return (p.bridgeBuffs?.intervals??[]).filter(x=>x.startTime<=t&&t<x.endTime);}
+function itemPill(i){return `<span class="item">${esc(pretty(i.recordKey??String(i.itemId)))}<small>T${i.itemTier??'?'} · ${num(i.shopPrice)} souls</small></span>`;}
+function teamOf(p){return state.model.teams.find(t=>Number(t.team)===Number(p.team));}
+function metric(id){for(const s of state.registry){const m=s.metrics.find(x=>x.id===id);if(m)return m;}return null;}
+function cautionStrip(){return `<div>${(state.model.cautions??[]).map(x=>`<div class="warning-box">${esc(x)}</div>`).join('')}</div>`;}
+function objectInline(o){if(!o)return'—';return Object.entries(o).map(([k,v])=>`${pretty(k)} ${v}`).join(' · ');}
+function clock(v,ms=false){if(!Number.isFinite(Number(v)))return'—';let x=Math.max(0,Number(v));const m=Math.floor(x/60),s=x-m*60;return ms?`${m}:${s.toFixed(3).padStart(6,'0')}`:`${m}:${Math.floor(s).toString().padStart(2,'0')}`;}
+function duration(v){if(!Number.isFinite(Number(v)))return'—';const x=Number(v);return x>=60?`${Math.floor(x/60)}m ${(x%60).toFixed(1)}s`:`${x.toFixed(1)}s`;}
+function num(v){if(!Number.isFinite(Number(v)))return'—';return Math.round(Number(v)).toLocaleString();}
+function signed(v){if(!Number.isFinite(Number(v)))return'—';return `${v>0?'+':''}${num(v)}`;}
+function fmt(v,d=1){return Number.isFinite(Number(v))?Number(v).toFixed(d):'—';}
+function pct(v){return Number.isFinite(Number(v))?`${(Number(v)*100).toFixed(1)}%`:'—';}
+function bytes(v){if(!Number.isFinite(v))return'—';const u=['B','KB','MB','GB'];let x=v,i=0;while(x>=1024&&i<u.length-1){x/=1024;i++;}return`${x.toFixed(i?1:0)} ${u[i]}`;}
