+      'AMMO_FRACTION_COHERENCE_DIAGNOSTIC_V02_INTEGRITY_FAILURE',
+      script198v02?.status
+        === 'AMMO_FRACTION_COHERENCE_DIAGNOSTIC_V02_INTEGRITY_FAILURE',
