+  return {
+    actual,
+    expected,
+    pass: Boolean(pass),
+  };
+}
+
+function percent(value) {
+  return Number.isFinite(value)
+    ? `${(value * 100).toFixed(2)}%`
+    : 'n/a';
+}
+
