+
+for (const [name, path] of Object.entries(PATHS)) {
+  if (name === 'output') continue;
+
+  if (!existsSync(path)) {
+    throw new Error(
+      `Missing ${name}:\n${path}`,
+    );
+  }
+}
+
+const script197 =
+  JSON.parse(
+    readFileSync(
+      PATHS.script197,
+      'utf8',
+    ),
+  );
+
+const script198v02 =
+  JSON.parse(
+    readFileSync(
+      PATHS.script198v02,
+      'utf8',
+    ),
+  );
+
+const exactRows =
+  script197
+    ?.audit
+    ?.exactRows;
+
+if (!Array.isArray(exactRows)) {
+  throw new Error(
+    'Script197 audit.exactRows missing.',
+  );
+}
+
+console.log('');
+console.log(
+  '========================================================',
+);
+console.log(
+  'AMMO FRACTION COHERENCE DIAGNOSTIC V0.3',
+);
+console.log(
+  '========================================================',
+);
+console.log('');
+console.log(
+  'Scientific question unchanged from V01/V02',
+);
+console.log(
+  'V02 failure cause: Array.map index leaked into tolerance parameter',
+);
+console.log(
+  `Frozen tolerance: ${FRACTION_TOLERANCE_V03}`,
+);
+console.log(
+  'Authority promotion: NO',
+);
+console.log('');
+
+const diagnostic =
+  summarizeFractionCoherenceV03(
+    exactRows,
+  );
+
+const zero5806 =
+  findRow(
+    diagnostic.zero.rows,
+    31,
+    5806,
+  );
+
+const zero174961 =
+  findRow(
+    diagnostic.zero.rows,
+    25,
+    174961,
+  );
+
+const gain85449 =
+  findRow(
+    diagnostic.negative.rows,
+    25,
+    85449,
+  );
+
+const checks = {
+  script197Ready:
+    check(
+      script197?.status,
+      'PHASE_CORRECTED_AMMO_RESIDUAL_AUDIT_V01_READY_FOR_INTERPRETATION',
