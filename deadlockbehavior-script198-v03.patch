+      === 'FRACTION_ROLLBACK_AND_COHERENT_RESTORATION_PARTITION_SELF_CONSISTENT_V03'
+      ? 'USE_V03_AS_CURRENT_FRACTION_COHERENCE_DIAGNOSTIC;_UPDATE_RESTORATION_CONTEXT_DISCOVERY_TO_CONSUME_V03_COHERENT_EVENTS'
