+      'cross_replay',
+      'raw_ammo_candidate_resource_discovery_v01.json',
+    ),
+};
+
+for (
+  const [name, path]
+  of Object.entries(PATHS)
+) {
+  if (name === 'output') continue;
+
+  if (!existsSync(path)) {
+    throw new Error(
+      `Missing ${name}:\n${path}`,
