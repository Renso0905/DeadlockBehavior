+} from '../src/vdata/raw-ammo-candidate-resource-discovery.mjs';
+
+const VERSION =
+  'RAW_AMMO_CANDIDATE_RESOURCE_DISCOVERY_V01';
+
+const ROOT =
+  resolve(
+    process.env.DEADLOCK_RESOURCE_SEARCH_ROOT
+    ?? '.',
+  );
+
+const PATHS = {
+  script204:
+    resolve(
+      'output',
+      'cross_replay',
+      'ammo_candidate_resource_semantics_audit_v02.json',
+    ),
+
+  effects:
+    resolve(
